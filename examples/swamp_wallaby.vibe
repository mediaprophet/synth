// ── Species Rule Pack (.q42): safe range of motion, injury thresholds, post-injury behaviour ──
// Authored as data; compiled by the anatomy op into a Q42LOGIC container (no Rust species tables).
let wallabia_bicolor_rules = [
    { kind: "permit", property: "q42:safeAnkleAchillesFlexionRad", value: 0.95 },
    { kind: "permit", property: "q42:safeCervicalNeckPitchRad", value: 0.75 },
    { kind: "permit", property: "q42:safeMandibularJawOpen01", value: 0.78 },
    { kind: "permit", property: "q42:safeForelimbReachRad", value: 1.15 },
    { kind: "forbid", property: "q42:injuryThresholdAchillesStrain01", value: 1.0 },
    { kind: "forbid", property: "q42:injuryThresholdForepawSprain01", value: 1.0 },
    { kind: "forbid", property: "q42:injuryThresholdCervicalHyperext01", value: 1.0 },
    { kind: "forbid", property: "q42:injuryThresholdCaudalTorque01", value: 1.0 },
    { kind: "obligate", property: "q42:obligateInjuredAsymmetricLimpGait", value: 0.35 },
    { kind: "obligate", property: "q42:obligateForepawProtectiveGuarding", value: 0.9 },
    { kind: "obligate", property: "q42:obligateNociceptiveEarPinBack", value: 0.85 },
    { kind: "obligate", property: "q42:obligateHerbivoryToMyceliumCoupling", value: 1.0 },
    { kind: "ltl_globally", property: "q42:ltlGloballyEnforceJointConeLimits", value: 60.0 },
    { kind: "ltl_globally", property: "q42:ltlGloballyClampSmallLlmHooksToSafeRom", value: 4.0 },
    { kind: "ltl_globally", property: "q42:ltlUntilWoundHealedMaintainGuarding", value: 1.0 },
    { kind: "ltl_globally", property: "q42:ltlGloballyVerifyNQuinXorParity", value: 1.0 }
];

// 1. Complete 3-Layer Swamp Wallaby (Exterior Bicolor Countershaded Pelage)
let wallaby_complete = capability.invoke("hypermedia.manifold.compile_vertebrate_anatomy_10d", {
