// 8. Acoustic Foot-Thump Alarm Synthesis (Low-Frequency Macropod Territorial Thump)
let thump_fund = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 82, sample_rate: 48000, frames: 14400, amplitude: 0.65
});
let thump_filtered = capability.invoke("hypermedia.acoustics.filter_biquad", {
    audio: thump_fund, mode: "lowpass", cutoff_hz: 190, q: 1.15
});
let thump_wav = capability.invoke("hypermedia.acoustics.encode_wav", {
    audio: thump_filtered
});

