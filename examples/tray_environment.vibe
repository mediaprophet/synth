// 2B. Music & Acoustic Composition — Harmonic Aether Etude (432 Hz Resonant Sculpts)
let music_raw = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 432, sample_rate: 48000, frames: 24000, amplitude: 0.55
});
let music_filtered = capability.invoke("hypermedia.acoustics.filter_biquad", {
    audio: music_raw, mode: "bandpass", cutoff_hz: 648, q: 1.4
});
let music_etude_wav = capability.invoke("hypermedia.acoustics.encode_wav", {
    audio: music_filtered
});

