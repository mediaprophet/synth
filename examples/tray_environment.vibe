import "vibe:0.3/nquin" as nquin;
requires [capability("capability.invoke")];

let parity = nquin.wire.compute_wire_parity([16, 32, 64, 128, 255]);

// ═════════════════════════════════════════════════════════════════════════════
// 1. WORLD OF MIND — SOFTWARE, SYSTEMS & SELF-HOSTED STUDIO CORE
// ═════════════════════════════════════════════════════════════════════════════
let badge_frame = capability.invoke("hypermedia.locus.construct", {
    shape: "rectangle", width: 52, height: 52, radius: 14, segments: 12
});
let core_ring = capability.invoke("hypermedia.locus.construct", {
    shape: "circle", radius: 18, segments: 48
});
let satellite_node = capability.invoke("hypermedia.locus.construct", {
    shape: "circle", radius: 8, segments: 32
});
let shifted_satellite = capability.invoke("hypermedia.locus.transform", {
    profile: satellite_node, matrix: [1, 0, 0, 1, 12, -10]
});

let emblem_svg = capability.invoke("hypermedia.locus.project_svg", {
    profile: badge_frame, fill: [16, 185, 129, 255], padding: 6
});

let tray_standalone_img = capability.invoke("hypermedia.radiance.rasterize_loci", {
    width: 64, height: 64, background: [11, 19, 24, 255],
    layers: [
        {profile: badge_frame, fill: [16, 185, 129, 255], matrix: [1, 0, 0, 1, 32, 32]},
        {profile: core_ring, fill: [14, 23, 21, 255], matrix: [1, 0, 0, 1, 32, 32]},
        {profile: shifted_satellite, fill: [56, 189, 248, 255], matrix: [1, 0, 0, 1, 32, 32]}
    ]
});
let tray_standalone_png = capability.invoke("hypermedia.radiance.encode_rgb_png", {
    image: tray_standalone_img
});

let tray_attached_img = capability.invoke("hypermedia.radiance.rasterize_loci", {
    width: 64, height: 64, background: [15, 23, 42, 255],
    layers: [
        {profile: badge_frame, fill: [56, 189, 248, 255], matrix: [1, 0, 0, 1, 32, 32]},
        {profile: core_ring, fill: [245, 158, 11, 255], matrix: [1, 0, 0, 1, 32, 32]},
        {profile: shifted_satellite, fill: [16, 185, 129, 255], matrix: [1, 0, 0, 1, 32, 32]}
    ]
});
let tray_attached_png = capability.invoke("hypermedia.radiance.encode_rgb_png", {
    image: tray_attached_img
});

let banner_plate = capability.invoke("hypermedia.locus.construct", {
    shape: "rectangle", width: 280, height: 84, radius: 18, segments: 12
});
let banner_base = capability.invoke("hypermedia.radiance.rasterize_loci", {
    width: 320, height: 112, background: [10, 18, 20, 255],
    layers: [
        {profile: banner_plate, fill: [20, 83, 74, 255], matrix: [1, 0, 0, 1, 160, 56]},
        {profile: core_ring, fill: [16, 185, 129, 255], matrix: [1, 0, 0, 1, 64, 56]},
        {profile: shifted_satellite, fill: [56, 189, 248, parity], matrix: [1, 0, 0, 1, 248, 56]}
    ]
});
let banner_glow = capability.invoke("hypermedia.radiance.convolve_blur", {image: banner_base});
let banner_bright = capability.invoke("hypermedia.radiance.transform_exposure", {
    image: banner_glow, stops: 0.45
});
let banner_blended = capability.invoke("hypermedia.radiance.blend_rgb", {
    image: banner_base, source: banner_bright, mode: "dodge"
});
let studio_banner_png = capability.invoke("hypermedia.radiance.encode_rgb_png", {
    image: banner_blended
});

let beacon_mesh = capability.invoke("hypermedia.manifold.revolve", {
    points: [[10, 0], [18, 10], [12, 24], [6, 32]], segments: 32
});
let beacon_10d = capability.invoke("hypermedia.manifold.compile_10d", {mesh: beacon_mesh});

let ready_tone = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 528, sample_rate: 48000, frames: 9600, amplitude: 0.35
});
let ready_leveled = capability.invoke("hypermedia.acoustics.scale_gain", {
    audio: ready_tone, gain: 0.6
});
let ready_wav = capability.invoke("hypermedia.acoustics.encode_wav", {
    audio: ready_leveled
});

let complete_tone = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 660, sample_rate: 48000, frames: 9600, amplitude: 0.35
});
let complete_leveled = capability.invoke("hypermedia.acoustics.scale_gain", {
    audio: complete_tone, gain: 0.6
});
let complete_wav = capability.invoke("hypermedia.acoustics.encode_wav", {
    audio: complete_leveled
});

