requires [capability("capability.invoke")];

// Independent physical field and timed recordings; the tone is not derived from E/B.
let reference_tone = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 440.0, sample_rate: 48000, frames: 24000, amplitude: 0.2
});
let recording = capability.invoke("hypermedia.electromagnetics.compile_emf", {
    origin: [-2.0, -2.0, -2.0], voxel_size: 0.5, grid_dims: [1, 1, 1],
    sources: [{position: [0.0, 0.0, -1.0], e_amplitude: [50.0, 0.0, 0.0], wavelength_nm: 850.0}],
    interpretation: {
        colour: {model: "spectral_only"}, hilbert_order: 2,
        spectral_semantics: "amplitude_centroid_legacy_sigma",
        timebase: {
            epoch: {scale: "relative", seconds: 0, nanoseconds: 0},
            ticks_per_second_num: 48000, ticks_per_second_den: 1,
            slice_start_tick: 0, slice_step_ticks: 480
        }
    },
    audio_tracks: [
        {audio: reference_tone, spec: {
            id: "reference-tone", purpose: "reference", channels: 1, channel_layout: "mono",
            sample_rate_num: 48000, sample_rate_den: 1, start_tick: 0,
            units: {unit: "normalized_amplitude"}, units_per_sample: 1.0
        }},
        {input: "pressure", spec: {
            id: "pressure", purpose: "recorded", channels: 1, channel_layout: "mono",
            sample_rate_num: 1000000, sample_rate_den: 1, start_tick: -24,
            units: {unit: "pascal"}, units_per_sample: 0.1
        }}
    ]
});
let checked = capability.invoke("hypermedia.electromagnetics.verify_emf", {emf: recording});
// This is a declared false-colour/visible display derivative of an IR field.
let projected = capability.invoke("hypermedia.electromagnetics.render_spectral_slice", {
    emf: recording, axis: "z", slice_index: 4, time_slice: 0, width: 512, height: 512, exposure: 3.0
});
let preview_png = capability.invoke("hypermedia.radiance.encode_rgba_png", {image: projected});
let listening_preview = capability.invoke("hypermedia.acoustics.encode_wav", {audio: reference_tone});
let asset = {files: [
    {key: "recording.emf", resource: recording},
    {key: "recording.png", resource: preview_png},
    {key: "reference-tone.wav", resource: listening_preview}
]};
