{
  "mcpServers": {
    "synth": {
      "command": "C:\\github\\synth\\target-prod\\debug\\synth-mcp.exe",
      "args": ["mcp"],
      "env": {
        "SYNTH_INPUT_ROOT": "C:\\github",
        "SYNTH_OUTPUT_ROOT": "C:\\github\\synth\\production"
      },
      "tools": {
