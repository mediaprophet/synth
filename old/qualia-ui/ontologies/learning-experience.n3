# Learning Experience Ontology — Learning Paths, Adaptive Learning,
# Tutorial Environments, and Elearning Toolbox Components
#
# Copyright © 2026 Timothy Charles Holborn. All rights reserved.
# Principal / inventor: Timothy Charles Holborn <timothy.holborn@gmail.com>
# Assignment: COPYRIGHT.md · Licence: LICENSE (CC BY-NC-ND 4.0)
#
# Defines vocabulary for structured and adaptive learning experiences —
# learning paths, courses, tutorials, interactive exercises, adaptive
# sequencing, and the elearning toolbox components that support them.
# Also defines incidental learning tracking — knowledge accumulated as
# a consequence of interactions, media consumption, and activities
# outside of structured learning.
#
# Core knowledge/skill vocabulary is in learning-core.n3.
# Both files share the lrn: prefix.
#
# Imports: learning-core.n3, personhood.n3, epistemics.n3, agency.n3,
#          provenance.n3, production-document.n3, hypermedia.n3,
#          portal-worlds.n3, game-design.n3

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix agency: <https://qualiadb.org/schema/ui/agency#> .
@prefix epi:    <https://purl.org/qualia/ontology/epistemics#> .
@prefix person: <https://qualiadb.org/schema/ui/personhood#> .
@prefix pd:     <https://qualiadb.org/schema/ui/production-document#> .
@prefix hm:     <https://qualiadb.org/schema/ui/hypermedia#> .
@prefix pw:     <https://qualiadb.org/schema/ui/portal-worlds#> .
@prefix game:   <https://qualiadb.org/schema/ui/game-design#> .
@prefix prov:   <https://qualiadb.org/schema/ui/provenance#> .
@prefix lrn:    <https://qualiadb.org/schema/ui/learning-core#> .

# ────────────────────────────────────────────────────────────────────
# 1. Learning Path — structured sequences of learning activities
# ────────────────────────────────────────────────────────────────────

lrn:LearningPath a rdfs:Class ;
    rdfs:label "Learning Path" ;
    rdfs:comment "A structured sequence of learning activities designed to develop proficiency in a skill or knowledge domain. A learning path may be linear (fixed sequence), branching (adaptive based on assessment results), or open (learner chooses order). Learning paths may be authored by educators, generated by software agents based on skill gap analysis, or self-constructed by the learner. A learning path has a target proficiency level and may have prerequisites." .

lrn:pathName a rdf:Property ;
    rdfs:label "path name" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  xsd:string .

lrn:pathDescription a rdf:Property ;
    rdfs:label "path description" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  xsd:string .

lrn:pathStructure a rdf:Property ;
    rdfs:label "path structure" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  lrn:PathStructure .

lrn:PathStructure a rdfs:Class ;
    rdfs:label "Path Structure" .

lrn:linearPath     a lrn:PathStructure ; rdfs:label "linear" ;
    rdfs:comment "Linear — fixed sequence. All learners follow the same order." .
lrn:branchingPath  a lrn:PathStructure ; rdfs:label "branching" ;
    rdfs:comment "Branching — the sequence adapts based on assessment results or learner choices. Different learners may follow different routes." .
lrn:openPath       a lrn:PathStructure ; rdfs:label "open" ;
    rdfs:comment "Open — the learner chooses the order of activities. The path defines available activities but not their sequence." .
lrn:adaptivePath   a lrn:PathStructure ; rdfs:label "adaptive" ;
    rdfs:comment "Adaptive — the sequence is dynamically generated by a software agent based on real-time performance data, engagement metrics, and learning preferences. The path is not pre-authored — it emerges from the adaptive engine." .

lrn:pathTargetSkill a rdf:Property ;
    rdfs:label "target skill" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  lrn:Skill ;
    rdfs:comment "The skill this path develops." .

lrn:pathTargetDomain a rdf:Property ;
    rdfs:label "target domain" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  lrn:KnowledgeDomain ;
    rdfs:comment "The knowledge domain this path covers." .

lrn:pathTargetLevel a rdf:Property ;
    rdfs:label "target level" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  lrn:ProficiencyLevel ;
    rdfs:comment "The proficiency level the path aims to achieve." .

lrn:pathPrerequisite a rdf:Property ;
    rdfs:label "path prerequisite" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  lrn:ProficiencyLevel ;
    rdfs:comment "Prerequisite proficiency level required to start this path." .

lrn:pathActivity a rdf:Property ;
    rdfs:label "path activity" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  lrn:LearningActivity ;
    rdfs:comment "A learning activity within this path." .

lrn:pathEstimatedDuration a rdf:Property ;
    rdfs:label "estimated duration" ;
    rdfs:domain lrn:LearningPath ;
    rdfs:range  xsd:string ;
    rdfs:comment "Estimated total duration — e.g. '4 weeks', '20 hours', 'self-paced'." .

# ────────────────────────────────────────────────────────────────────
# 2. Learning Activity — individual units of learning
# ────────────────────────────────────────────────────────────────────

lrn:LearningActivity a rdfs:Class ;
    rdfs:label "Learning Activity" ;
    rdfs:comment "A single unit of learning within a learning path — a lesson, exercise, reading, video, interactive simulation, quiz, project, or discussion. Activities have a type, duration, difficulty, and may produce assessable outcomes. Activities may be hypermedia assets (videos, interactive documents), portal-world scenes (3D simulations), or game-based experiences (serious games)." .

lrn:activityType a rdf:Property ;
    rdfs:label "activity type" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  lrn:ActivityType .

lrn:ActivityType a rdfs:Class ;
    rdfs:label "Activity Type" .

lrn:actLesson       a lrn:ActivityType ; rdfs:label "lesson" ;
    rdfs:comment "Lesson — structured presentation of new material. May include text, diagrams, video, audio." .
lrn:actExercise     a lrn:ActivityType ; rdfs:label "exercise" ;
    rdfs:comment "Exercise — practice activity with feedback. May be auto-graded or peer-reviewed." .
lrn:actReading      a lrn:ActivityType ; rdfs:label "reading" ;
    rdfs:comment "Reading — text-based material (book chapter, article, documentation)." .
lrn:actVideo        a lrn:ActivityType ; rdfs:label "video" ;
    rdfs:comment "Video — instructional video, lecture recording, demonstration." .
lrn:actInteractive  a lrn:ActivityType ; rdfs:label "interactive" ;
    rdfs:comment "Interactive — interactive simulation, virtual lab, 3D model exploration." .
lrn:actQuiz         a lrn:ActivityType ; rdfs:label "quiz" ;
    rdfs:comment "Quiz — formative assessment with immediate feedback. Not high-stakes." .
lrn:actAssessment   a lrn:ActivityType ; rdfs:label "assessment" ;
    rdfs:comment "Assessment — summative assessment. Higher stakes. Contributes to proficiency evaluation." .
lrn:actProject      a lrn:ActivityType ; rdfs:label "project" ;
    rdfs:comment "Project — extended activity producing a deliverable. May span multiple sessions." .
lrn:actDiscussion   a lrn:ActivityType ; rdfs:label "discussion" ;
    rdfs:comment "Discussion — collaborative activity with other learners or instructors." .
lrn:actGameBased    a lrn:ActivityType ; rdfs:label "game-based" ;
    rdfs:comment "Game-based — learning through a serious game or educational game. Links to game-design.n3." .
lrn:actSimulation   a lrn:ActivityType ; rdfs:label "simulation" ;
    rdfs:comment "Simulation — learning through a simulated environment. May use portal-worlds.n3 scenes." .
lrn:actMentorship   a lrn:ActivityType ; rdfs:label "mentorship" ;
    rdfs:comment "Mentorship — one-on-one guidance from a more experienced practitioner." .
lrn:actReflection   a lrn:ActivityType ; rdfs:label "reflection" ;
    rdfs:comment "Reflection — structured reflection on learning or experience. May produce a reflective journal entry." .
lrn:actMediaAnalysis a lrn:ActivityType ; rdfs:label "media-analysis" ;
    rdfs:comment "Media analysis — analysing media content (article, documentary, podcast) for learning. Intentional learning from media sources." .

lrn:activityTitle a rdf:Property ;
    rdfs:label "activity title" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  xsd:string .

lrn:activityDescription a rdf:Property ;
    rdfs:label "activity description" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  xsd:string .

lrn:activityDifficulty a rdf:Property ;
    rdfs:label "difficulty" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  lrn:Difficulty .

lrn:Difficulty a rdfs:Class ;
    rdfs:label "Difficulty" .

lrn:diffIntroductory a lrn:Difficulty ; rdfs:label "introductory" .
lrn:diffBeginner     a lrn:Difficulty ; rdfs:label "beginner" .
lrn:diffIntermediate  a lrn:Difficulty ; rdfs:label "intermediate" .
lrn:diffAdvanced     a lrn:Difficulty ; rdfs:label "advanced" .
lrn:diffExpert       a lrn:Difficulty ; rdfs:label "expert" .

lrn:activityDuration a rdf:Property ;
    rdfs:label "duration" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  xsd:string .

lrn:activityResource a rdf:Property ;
    rdfs:label "resource" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI of the hypermedia asset, document, portal-world scene, or game that constitutes this activity." .

lrn:activityAssessment a rdf:Property ;
    rdfs:label "activity assessment" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  lrn:SkillAssessment ;
    rdfs:comment "If this activity includes assessment, the skill assessment it produces." .

lrn:activityPrerequisite a rdf:Property ;
    rdfs:label "activity prerequisite" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  lrn:LearningActivity ;
    rdfs:comment "An activity that must be completed before this one." .

lrn:activityLearningOutcome a rdf:Property ;
    rdfs:label "expected outcome" ;
    rdfs:domain lrn:LearningActivity ;
    rdfs:range  lrn:LearningOutcome ;
    rdfs:comment "The expected learning outcome if the activity is completed successfully." .

# ────────────────────────────────────────────────────────────────────
# 3. Adaptive Learning — dynamic personalisation
# ────────────────────────────────────────────────────────────────────

lrn:AdaptiveEngine a rdfs:Class ;
    rdfs:label "Adaptive Learning Engine" ;
    rdfs:comment "A software system that dynamically adjusts the learning path based on learner performance, engagement, and preferences. The adaptive engine selects the next activity, adjusts difficulty, provides remediation or acceleration, and may recommend alternative approaches. The engine is a software agent — it computes recommendations from performance data; it does not understand the learner or the content. Adaptation decisions are based on algorithms (Bayesian knowledge tracing, item response theory, rule-based sequencing, or machine learning models). All adaptation decisions should be transparent and explainable — the learner should be able to see why a particular activity was recommended." .

lrn:adaptiveAlgorithm a rdf:Property ;
    rdfs:label "adaptive algorithm" ;
    rdfs:domain lrn:AdaptiveEngine ;
    rdfs:range  lrn:AdaptiveAlgorithm .

lrn:AdaptiveAlgorithm a rdfs:Class ;
    rdfs:label "Adaptive Algorithm" .

lrn:bayesianKnowledgeTracing a lrn:AdaptiveAlgorithm ; rdfs:label "bayesian-knowledge-tracing" ;
    rdfs:comment "Bayesian Knowledge Tracing — estimates the probability that the learner has mastered a skill based on their performance on related activities." .
lrn:itemResponseTheory a lrn:AdaptiveAlgorithm ; rdfs:label "item-response-theory" ;
    rdfs:comment "Item Response Theory — models the relationship between learner ability and item difficulty to select appropriate activities." .
lrn:ruleBasedSequencing a lrn:AdaptiveAlgorithm ; rdfs:label "rule-based-sequencing" ;
    rdfs:comment "Rule-based sequencing — pre-authored rules determine the next activity based on performance thresholds." .
lrn:mlBasedAdaptation a lrn:AdaptiveAlgorithm ; rdfs:label "ml-based" ;
    rdfs:comment "Machine learning — a trained model predicts the optimal next activity. The model computes from patterns; it does not understand the learner. Output may be ungrounded generation if the model is not grounded in learning science data." .

lrn:adaptiveFactors a rdf:Property ;
    rdfs:label "adaptive factors" ;
    rdfs:domain lrn:AdaptiveEngine ;
    rdfs:range  xsd:string ;
    rdfs:comment "Factors the engine considers — performance history, engagement metrics, time spent, error patterns, learning style preferences, prior knowledge (CBOR-LD encoded)." .

lrn:adaptiveExplanation a rdf:Property ;
    rdfs:label "adaptation explanation" ;
    rdfs:domain lrn:AdaptiveEngine ;
    rdfs:range  xsd:string ;
    rdfs:comment "Explanation for why a particular adaptation was made — e.g. 'You scored below threshold on quiz 3; recommending remedial exercise on fractions'. Transparency requirement." .

lrn:adaptivePath a rdf:Property ;
    rdfs:label "adaptive path" ;
    rdfs:domain lrn:AdaptiveEngine ;
    rdfs:range  lrn:LearningPath ;
    rdfs:comment "The learning path being adapted. For adaptive paths, the path is dynamically modified by the engine." .

# ────────────────────────────────────────────────────────────────────
# 4. Tutorial Environment — interactive learning spaces
# ────────────────────────────────────────────────────────────────────

lrn:TutorialEnvironment a rdfs:Class ;
    rdfs:label "Tutorial Environment" ;
    rdfs:comment "An interactive learning space — may be a 2D interface (web-based tutorial), a 3D environment (portal-world scene), or a game-based environment (serious game). Tutorial environments provide structured guidance, interactive exercises, feedback, and progress tracking. A tutorial environment may be a manifold — a container with tools, resources, and interactive components. Tutorial environments may incorporate real-world data (historical, geographic, scientific) for grounded learning, similar to game world grounding." .

lrn:tutorialType a rdf:Property ;
    rdfs:label "tutorial type" ;
    rdfs:domain lrn:TutorialEnvironment ;
    rdfs:range  lrn:TutorialType .

lrn:TutorialType a rdfs:Class ;
    rdfs:label "Tutorial Type" .

lrn:tutInteractiveDoc a lrn:TutorialType ; rdfs:label "interactive-document" ;
    rdfs:comment "Interactive document — text, diagrams, embedded exercises, code playground. Web-based." .
lrn:tutVirtualLab    a lrn:TutorialType ; rdfs:label "virtual-lab" ;
    rdfs:comment "Virtual lab — simulated laboratory environment. May use portal-worlds.n3 scenes for 3D labs." .
lrn:tutImmersive     a lrn:TutorialType ; rdfs:label "immersive" ;
    rdfs:comment "Immersive — fully immersive 3D or VR environment. Uses portal-worlds.n3." .
lrn:tutGameBased     a lrn:TutorialType ; rdfs:label "game-based" ;
    rdfs:comment "Game-based — learning through a serious game. Uses game-design.n3." .
lrn:tutAugmented     a lrn:TutorialType ; rdfs:label "augmented" ;
    rdfs:comment "Augmented — AR overlay on real-world environment. Combines real-world data with digital guidance." .
lrn:tutMixed         a lrn:TutorialType ; rdfs:label "mixed" ;
    rdfs:comment "Mixed — combines multiple tutorial types. e.g. interactive document with embedded virtual lab and game-based exercises." .

lrn:tutorialScene a rdf:Property ;
    rdfs:label "tutorial scene" ;
    rdfs:domain lrn:TutorialEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI of the portal-world scene or game world that hosts this tutorial environment, if applicable." .

lrn:tutorialManifold a rdf:Property ;
    rdfs:label "tutorial manifold" ;
    rdfs:domain lrn:TutorialEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI of the manifold (container) that holds this tutorial's tools, resources, and components." .

lrn:tutorialGrounding a rdf:Property ;
    rdfs:label "tutorial grounding" ;
    rdfs:domain lrn:TutorialEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Real-world data grounding — if the tutorial uses real-world data (historical events, geographic data, scientific datasets), the grounding specification. Similar to game:RealWorldGrounding." .

lrn:tutorialFeedbackMode a rdf:Property ;
    rdfs:label "feedback mode" ;
    rdfs:domain lrn:TutorialEnvironment ;
    rdfs:range  lrn:FeedbackMode .

lrn:FeedbackMode a rdfs:Class ;
    rdfs:label "Feedback Mode" .

lrn:feedbackImmediate a lrn:FeedbackMode ; rdfs:label "immediate" ;
    rdfs:comment "Immediate — feedback is given as soon as the learner responds. Best for skill practice." .
lrn:feedbackDelayed   a lrn:FeedbackMode ; rdfs:label "delayed" ;
    rdfs:comment "Delayed — feedback is given after the activity is complete. Best for synthesis and reflection." .
lrn:feedbackAdaptive  a lrn:FeedbackMode ; rdfs:label "adaptive" ;
    rdfs:comment "Adaptive — feedback timing and content are determined by the adaptive engine based on learner performance." .
lrn:feedbackPeer      a lrn:FeedbackMode ; rdfs:label "peer" ;
    rdfs:comment "Peer — feedback is provided by other learners. Intersubjective assessment." .
lrn:feedbackInstructor a lrn:FeedbackMode ; rdfs:label "instructor" ;
    rdfs:comment "Instructor — feedback is provided by a human instructor or mentor." .
lrn:feedbackAutomated a lrn:FeedbackMode ; rdfs:label "automated" ;
    rdfs:comment "Automated — feedback is generated by a software agent. The agent computes feedback from rules or model output; it does not understand the learner's work." .

# ────────────────────────────────────────────────────────────────────
# 5. Incidental Learning Tracker — learning from everyday activities
# ────────────────────────────────────────────────────────────────────

lrn:IncidentalLearningTracker a rdfs:Class ;
    rdfs:label "Incidental Learning Tracker" ;
    rdfs:comment "A system that monitors a person's activities, interactions, and media consumption to identify incidental learning events — knowledge or skills acquired as a by-product of non-educational activities. The tracker analyses interaction patterns, content engagement, and task performance to infer learning. Inferred learning has lower confidence than intentional learning — it is a hypothesis, not a verified assessment. The tracker may recommend formal assessment if incidental learning appears to have reached an assessable level. The tracker is a software agent — it computes inferences from data; it does not understand the content or the learner. All inferred learning events should be marked with provenance and confidence levels." .

lrn:trackerTarget a rdf:Property ;
    rdfs:label "tracker target" ;
    rdfs:domain lrn:IncidentalLearningTracker ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI of the person whose activities are being tracked." .

lrn:trackerDataSources a rdf:Property ;
    rdfs:label "data sources" ;
    rdfs:domain lrn:IncidentalLearningTracker ;
    rdfs:range  xsd:string ;
    rdfs:comment "Data sources monitored — interaction logs, media consumption history, work outputs, communication patterns, project contributions (CBOR-LD encoded)." .

lrn:trackerInferredEvent a rdf:Property ;
    rdfs:label "inferred event" ;
    rdfs:domain lrn:IncidentalLearningTracker ;
    rdfs:range  lrn:LearningEvent ;
    rdfs:comment "An incidental learning event inferred by the tracker. The event has type 'incidental' and a confidence level reflecting the inference quality." .

lrn:trackerRecommendation a rdf:Property ;
    rdfs:label "recommendation" ;
    rdfs:domain lrn:IncidentalLearningTracker ;
    rdfs:range  xsd:string ;
    rdfs:comment "Recommendation based on inferred learning — e.g. 'consider formal assessment for skill: data analysis', 'learning path: advanced statistics may be suitable', 'RPL evidence available: 6 months of project work in domain: software engineering'." .

lrn:trackerConfidence a rdf:Property ;
    rdfs:label "tracker confidence" ;
    rdfs:domain lrn:IncidentalLearningTracker ;
    rdfs:range  xsd:float ;
    rdfs:comment "Overall confidence in the tracker's inferences (0.0 to 1.0). Depends on data quality, data coverage, and inference model accuracy." .

lrn:trackerEpistemicMode a rdf:Property ;
    rdfs:label "tracker epistemic mode" ;
    rdfs:domain lrn:IncidentalLearningTracker ;
    rdfs:range  epi:EpistemicMode ;
    rdfs:comment "The epistemic mode of the tracker's inferences — inferred (not directly observed), so typically 'ambiguous' or 'subjective' unless corroborated by assessment." .

# ────────────────────────────────────────────────────────────────────
# 6. Elearning Toolbox — UI components and tools
# ────────────────────────────────────────────────────────────────────

lrn:ElearningToolbox a rdfs:Class ;
    rdfs:label "Elearning Toolbox" ;
    rdfs:comment "A collection of UI components, tools, and functions for elearning experiences within the hypermedia manifold system. The elearning toolbox provides the building blocks for creating interactive learning interfaces — lesson viewers, exercise editors, quiz builders, progress trackers, adaptive content panels, and feedback displays. These components are manifold elements that can be assembled into tutorial environments and learning paths." .

lrn:ElearningComponent a rdfs:Class ;
    rdfs:label "Elearning Component" ;
    rdfs:comment "A single UI component or tool within the elearning toolbox. Components have a type, a function, and may produce or consume learning data." .

lrn:componentType a rdf:Property ;
    rdfs:label "component type" ;
    rdfs:domain lrn:ElearningComponent ;
    rdfs:range  lrn:ComponentType .

lrn:ComponentType a rdfs:Class ;
    rdfs:label "Component Type" .

lrn:compLessonViewer    a lrn:ComponentType ; rdfs:label "lesson-viewer" ;
    rdfs:comment "Lesson viewer — displays lesson content (text, images, video, interactive elements)." .
lrn:compExerciseEditor  a lrn:ComponentType ; rdfs:label "exercise-editor" ;
    rdfs:comment "Exercise editor — interactive editor for completing exercises (text, code, mathematical, diagrammatic)." .
lrn:compQuizBuilder     a lrn:ComponentType ; rdfs:label "quiz-builder" ;
    rdfs:comment "Quiz builder — creates and renders quizzes (multiple choice, short answer, matching, ordering)." .
lrn:compProgressTracker a lrn:ComponentType ; rdfs:label "progress-tracker" ;
    rdfs:comment "Progress tracker — visualises learner progress through a learning path (completion percentage, skill levels, time spent)." .
lrn:compSkillRadar      a lrn:ComponentType ; rdfs:label "skill-radar" ;
    rdfs:comment "Skill radar — radar chart visualising proficiency across multiple skills or domains." .
lrn:compGapAnalyser     a lrn:ComponentType ; rdfs:label "gap-analyser" ;
    rdfs:comment "Gap analyser — visualises skill gaps between current profile and target requirements." .
lrn:compAdaptivePanel   a lrn:ComponentType ; rdfs:label "adaptive-panel" ;
    rdfs:comment "Adaptive panel — displays content recommended by the adaptive engine, with explanation of why it was recommended." .
lrn:compFeedbackDisplay a lrn:ComponentType ; rdfs:label "feedback-display" ;
    rdfs:comment "Feedback display — shows assessment results, corrections, explanations, and improvement suggestions." .
lrn:compPathNavigator   a lrn:ComponentType ; rdfs:label "path-navigator" ;
    rdfs:comment "Path navigator — visualises the learning path structure, current position, and available next steps." .
lrn:compPortfolioViewer a lrn:ComponentType ; rdfs:label "portfolio-viewer" ;
    rdfs:comment "Portfolio viewer — displays the learner's collected work samples and evidence." .
lrn:compPeerReview      a lrn:ComponentType ; rdfs:label "peer-review" ;
    rdfs:comment "Peer review — interface for reviewing and providing feedback on other learners' work." .
lrn:compMentorChat      a lrn:ComponentType ; rdfs:label "mentor-chat" ;
    rdfs:comment "Mentor chat — communication interface between learner and mentor/instructor." .
lrn:compBadgeDisplay    a lrn:ComponentType ; rdfs:label "badge-display" ;
    rdfs:comment "Badge display — visualises earned badges, certificates, and qualifications." .
lrn:compTimeline        a lrn:ComponentType ; rdfs:label "learning-timeline" ;
    rdfs:comment "Learning timeline — chronological view of learning events, assessments, and milestones." .
lrn:compAssuranceMeter  a lrn:ComponentType ; rdfs:label "assurance-meter" ;
    rdfs:comment "Assurance meter — visualises the assurance level for each skill/domain, showing how well-verified the proficiency is." .
lrn:compRPLWizard       a lrn:ComponentType ; rdfs:label "rpl-wizard" ;
    rdfs:comment "RPL wizard — guided interface for submitting prior learning evidence and requesting RPL assessment." .
lrn:compMediaAnalyser   a lrn:ComponentType ; rdfs:label "media-analyser" ;
    rdfs:comment "Media analyser — tool for analysing media content (articles, videos, podcasts) for learning purposes. Extracts key concepts, generates summaries, creates flashcards." .
lrn:compIncidentalLog   a lrn:ComponentType ; rdfs:label "incidental-log" ;
    rdfs:comment "Incidental learning log — displays incidental learning events detected by the tracker, with confidence levels and recommendations." .

lrn:componentFunction a rdf:Property ;
    rdfs:label "component function" ;
    rdfs:domain lrn:ElearningComponent ;
    rdfs:range  xsd:string ;
    rdfs:comment "What the component does — its functional specification." .

lrn:componentInput a rdf:Property ;
    rdfs:label "component input" ;
    rdfs:domain lrn:ElearningComponent ;
    rdfs:range  xsd:string ;
    rdfs:comment "What data the component consumes — e.g. 'skill profile', 'learning path', 'assessment result'." .

lrn:componentOutput a rdf:Property ;
    rdfs:label "component output" ;
    rdfs:domain lrn:ElearningComponent ;
    rdfs:range  xsd:string ;
    rdfs:comment "What data the component produces — e.g. 'exercise response', 'assessment result', 'progress update'." .

lrn:componentManifold a rdf:Property ;
    rdfs:label "component manifold" ;
    rdfs:domain lrn:ElearningComponent ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI of the manifold this component belongs to." .

lrn:hasElearningToolbox a rdf:Property ;
    rdfs:label "has elearning toolbox" ;
    rdfs:domain lrn:TutorialEnvironment ;
    rdfs:range  lrn:ElearningToolbox ;
    rdfs:comment "Links a tutorial environment to its elearning toolbox." .

lrn:toolboxComponent a rdf:Property ;
    rdfs:label "toolbox component" ;
    rdfs:domain lrn:ElearningToolbox ;
    rdfs:range  lrn:ElearningComponent ;
    rdfs:comment "A component in this toolbox." .

# ────────────────────────────────────────────────────────────────────
# 7. Learning Manifold — container for learning experiences
# ────────────────────────────────────────────────────────────────────

lrn:LearningManifold a rdfs:Class ;
    rdfs:label "Learning Manifold" ;
    rdfs:comment "A manifold (container) that holds a complete learning experience — one or more learning paths, tutorial environments, elearning toolboxes, assessment instruments, and resource libraries. A learning manifold is the top-level container for an elearning offering. It may be a course, a training program, a self-directed learning environment, or a blended learning package. The manifold defines the scope, audience, and configuration of the learning experience." .

lrn:manifoldTitle a rdf:Property ;
    rdfs:label "manifold title" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  xsd:string .

lrn:manifoldDescription a rdf:Property ;
    rdfs:label "manifold description" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  xsd:string .

lrn:manifoldPath a rdf:Property ;
    rdfs:label "manifold path" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  lrn:LearningPath .

lrn:manifoldTutorial a rdf:Property ;
    rdfs:label "manifold tutorial" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  lrn:TutorialEnvironment .

lrn:manifoldToolbox a rdf:Property ;
    rdfs:label "manifold toolbox" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  lrn:ElearningToolbox .

lrn:manifoldAdaptiveEngine a rdf:Property ;
    rdfs:label "manifold adaptive engine" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  lrn:AdaptiveEngine .

lrn:manifoldTracker a rdf:Property ;
    rdfs:label "manifold tracker" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  lrn:IncidentalLearningTracker ;
    rdfs:comment "If this manifold tracks incidental learning, the tracker instance." .

lrn:manifoldAudience a rdf:Property ;
    rdfs:label "audience" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  xsd:string ;
    rdfs:comment "Target audience — e.g. 'beginners', 'professionals seeking CPD', 'students preparing for exam', 'general public'." .

lrn:manifoldMode a rdf:Property ;
    rdfs:label "manifold mode" ;
    rdfs:domain lrn:LearningManifold ;
    rdfs:range  lrn:ManifoldMode .

lrn:ManifoldMode a rdfs:Class ;
    rdfs:label "Manifold Mode" .

lrn:modeSelfPaced    a lrn:ManifoldMode ; rdfs:label "self-paced" ;
    rdfs:comment "Self-paced — learner progresses at their own speed. No fixed schedule." .
lrn:modeCohort       a lrn:ManifoldMode ; rdfs:label "cohort" ;
    rdfs:comment "Cohort — a group of learners progress together on a schedule. Includes social learning elements." .
lrn:modeInstructorLed a lrn:ManifoldMode ; rdfs:label "instructor-led" ;
    rdfs:comment "Instructor-led — an instructor guides the learning, provides feedback, and assesses progress." .
lrn:modeBlended      a lrn:ManifoldMode ; rdfs:label "blended" ;
    rdfs:comment "Blended — combines self-paced, cohort, and instructor-led elements." .
lrn:modeAdaptive     a lrn:ManifoldMode ; rdfs:label "adaptive" ;
    rdfs:comment "Adaptive — the adaptive engine determines pace, content, and sequence for each learner." .

# ────────────────────────────────────────────────────────────────────
# 8. Linking to other ontologies
# ────────────────────────────────────────────────────────────────────

# This ontology (learning-experience.n3) links to:
#
# learning-core.n3:
#   - Shares the lrn: prefix
#   - Learning activities target skills and domains defined in learning-core
#   - Adaptive engine uses skill profiles and gap analysis from learning-core
#   - Incidental learning tracker produces learning events (learning-core)
#   - Assessment activities produce skill assessments (learning-core)
#
# hypermedia.n3:
#   - Learning activities may be hypermedia assets
#   - Elearning components are manifold elements
#   - Learning manifolds are containers in the hypermedia system
#
# portal-worlds.n3:
#   - Tutorial environments may use portal-world scenes (virtual labs,
#     immersive environments)
#   - 3D simulations for learning use pw:World and pw:EnvironmentObject
#
# game-design.n3:
#   - Game-based learning activities use game:Game
#   - Serious games are a subset of games with educational objectives
#   - Game mechanics (progression, quests) may be used for learning
#     gamification
#
# production-document.n3:
#   - Learning materials (lessons, readings) may be production documents
#   - Course specifications may be functional specs
#   - Assessment rubrics may be style guides
#
# epistemics.n3:
#   - Assessment confidence uses epistemic confidence
#   - Incidental learning inferences have epistemic mode (inferred)
#   - Adaptive engine recommendations may be ungrounded generation
#     if not grounded in learning science data
#
# agency.n3:
#   - Adaptive engines and trackers are software agents
#   - Instructors and mentors are natural agents
#   - Automated assessment uses software agents
#
# provenance.n3:
#   - All learning events, assessments, and adaptive decisions
#     have provenance
